

@model IEnumerable<Stitch.Core.OutputModels.KitOutputModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Наборы для вышивания</h1>

<div style="display: flex; align-items: center;">
    <form data-ajax="true" data-ajax-url="/Kit/KitSearch"
          data-ajax-update="#results" data-ajax-mode="after">
        <label>Название: </label>
        <input type="text" name="searchKitName" placeholder="Поиск..." />
        <label>Номер набора: </label>
        <input type="text" name="searchKitNumber" placeholder="Поиск..." />
        <label> Производитель:
        @Html.DropDownList("searchManufId", // Имя параметра в POST/GET
                            (SelectList)ViewBag.ManufacturerList,
                            "--Выберите--", // Текст по умолчанию (OptionLabel)
                            new { @class = "form-control", style = "width: 150px;"  })
        </label>
        <input type="submit" value="Поиск" />
    </form>
</div>

@Html.ValidationSummary(false, "", new { @class = "text-danger" })
<p>
    <a asp-action="Create">Create New</a>
</p>

<p>
    @Html.ActionLink("Скачать PDF", "ExportToPdf", "Kit", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-hover align-middle border shadow-sm">
    <thead class="table-light">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KitNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ManufacturerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CanvasName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageLink)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ComplexityName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.KitNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ManufacturerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CanvasName)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageLink))
                    {
                        <img src="@item.ImageLink" alt="customer" style="width:50px; height:50px; object-fit:cover;" class="rounded" />
                    }
                    else
                    {
                        <div class="bg-light text-center rounded" style="width:50px; height:50px; line-height:60px;">📦</div>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ComplexityName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a> |
                   
                    <a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>|

                    @Html.ActionLink("Тематика", "Edit", "KitThemes", new { id = @item.Id }, null)
                </td>

            </tr>
        }

    </tbody>
</table>
