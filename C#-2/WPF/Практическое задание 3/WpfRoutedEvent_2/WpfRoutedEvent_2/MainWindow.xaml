<Window x:Class="WpfRoutedEvent_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfRoutedEvent_2"
        mc:Ignorable="d"
        Title="Использование маршрутизированных событий" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="txtBox"  HorizontalAlignment="Left" Margin="177,56,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="145"/>
        <StackPanel ButtonBase.Click="StackPanel_Click" Margin="50,150,50,50">
            
            <Button x:Name="butAdd" Content="Сложить"/>
            <Button x:Name="butMult" Content="Умножить"/>
            <Button x:Name="butSqrt" Content="Извлечь корень"/>
        </StackPanel>
    </Grid>
</Window>
