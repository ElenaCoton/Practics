<Window x:Class="Calc_inerface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calc_inerface"
        mc:Ignorable="d"
        Title="Модель калькулятора" Height="650" Width="700" MinHeight="400" MinWidth="300">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.Column="0">
            <MenuItem x:Name="HelpCom"  Header="Help">
                <MenuItem x:Name="itemHelp" Header="About..."/>
            </MenuItem>
            <MenuItem x:Name="ExitCom"  Header="Exit"></MenuItem>
        </Menu>
        <TextBox x:Name="myDisplay" Background="ForestGreen"  FontSize ="16" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" HorizontalContentAlignment="Right" IsReadOnly="True" Margin="5,5,5,5"/>
        <Button Grid.Row="2" Grid.Column="0" FontSize="20" Margin="5,5,5,5">7</Button>
        <Button Grid.Row="2" Grid.Column="1" FontSize="20" Margin="5,5,5,5">8</Button>
        <Button Grid.Row="2" Grid.Column="2" FontSize="20" Margin="5,5,5,5">9</Button>
        <Button Grid.Row="2" Grid.Column="3" FontSize="20" Margin="5,5,5,5">+</Button>
        <Button Grid.Row="3" Grid.Column="0" FontSize="20" Margin="5,5,5,5">4</Button>
        <Button Grid.Row="3" Grid.Column="1" FontSize="20" Margin="5,5,5,5">5</Button>
        <Button Grid.Row="3" Grid.Column="2" FontSize="20" Margin="5,5,5,5">6</Button>
        <Button Grid.Row="3" Grid.Column="3" FontSize="20" Margin="5,5,5,5">-</Button>
        <Button Grid.Row="4" Grid.Column="0" FontSize="20" Margin="5,5,5,5">1</Button>
        <Button Grid.Row="4" Grid.Column="1" FontSize="20" Margin="5,5,5,5">2</Button>
        <Button Grid.Row="4" Grid.Column="2" FontSize="20" Margin="5,5,5,5">3</Button>
        <Button Grid.Row="4" Grid.Column="3" FontSize="20" Margin="5,5,5,5">*</Button>
        <Button Grid.Row="5" Grid.Column="0" FontSize="20" Margin="5,5,5,5">0</Button>
        <Button Grid.Row="5" Grid.Column="1" FontSize="20" Margin="5,5,5,5">,</Button>
        <Button Grid.Row="5" Grid.Column="2" FontSize="20" Margin="5,5,5,5">+/-</Button>
        <Button Grid.Row="5" Grid.Column="3" FontSize="20" Margin="5,5,5,5">%</Button>
        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" FontSize="20" Margin="5,5,5,5">=</Button>
        <Button Grid.Row="6" Grid.Column="3" FontSize="20" Margin="5,5,5,5">C</Button>
    </Grid>
    
</Window>
